#include <windows.h>

/* Application icon */
101 ICON "assets/tower.ico"

/* Per-monitor DPI awareness and common controls version 6 */
1 24 "src/app.manifest"

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "The Hollow Spire - an ASCII text adventure\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "HollowSpire\0"
            VALUE "OriginalFilename", "HollowSpire.exe\0"
            VALUE "ProductName", "The Hollow Spire\0"
            VALUE "ProductVersion", "1.0.0.0\0"
            VALUE "LegalCopyright", "Released into the public domain\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
