#include <windows.h>

/* Application icon: 10x10 black-and-white pixel art */
101 ICON "assets/library.ico"

/* Title typeface: Squealer, CC0 1.0 (assets/fonts) */
102 RCDATA "assets/fonts/squealer.otf"

/* Music: three CC0 ambient tracks (assets/audio/CREDITS.txt).
   201 intro, 202 menu, 203 room. The app streams them through waveOut. */
201 RCDATA "assets/audio/intro.wav"
202 RCDATA "assets/audio/menu.wav"
203 RCDATA "assets/audio/room.wav"

/* The application manifest is left to the linker's default: MinGW's ld always
   embeds one and cannot merge another, and the app sets per-monitor DPI
   awareness at startup with SetProcessDpiAwarenessContext. */

1 VERSIONINFO
FILEVERSION 1,0,0,0
PRODUCTVERSION 1,0,0,0
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Anaise - a black and white game library\0"
            VALUE "FileVersion", "1.0.0.0\0"
            VALUE "InternalName", "Anaise\0"
            VALUE "OriginalFilename", "Anaise.exe\0"
            VALUE "ProductName", "Anaise\0"
            VALUE "ProductVersion", "1.0.0.0\0"
            VALUE "LegalCopyright", "Released into the public domain\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
